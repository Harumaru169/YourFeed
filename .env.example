# Docker: copy to .env. Without Docker: set these in the environment, plus DATABASE_URL.
POSTGRES_PASSWORD=
SEARXNG_SECRET=
# DATABASE_URL=postgresql://yourfeed:password@127.0.0.1:5432/yourfeed
# SEARXNG_URL=http://127.0.0.1:8888

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Subscription CLIs to put in the Docker image: claude, codex, gemini (comma-separated)
YOURFEED_CLIS=

YOURFEED_PORT=8000
YOURFEED_SEARCH_PORT=8888
YOURFEED_TIMEZONE=Asia/Tokyo
YOURFEED_ALLOWED_HOSTS=
YOURFEED_ALLOW_PRIVATE_URLS=
